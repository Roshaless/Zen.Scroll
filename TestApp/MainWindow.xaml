<Window
    x:Class="TestApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="控件画廊 · 滚动测试"
    Width="800"
    Height="600"
    WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!--  样式：分组标题（只保留字体大小和粗细，颜色继承默认）  -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,12,0,6" />
        </Style>

        <!--  样式：控件卡片（只保留边框、圆角和间距，颜色依赖默认）  -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="BorderBrush" Value="{x:Null}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Background" Value="{x:Null}" />
        </Style>

        <!--  样式：控件标签  -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
    </Window.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid Margin="30,20,30,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  ============ 左列 ============  -->
            <StackPanel Grid.Column="0">

                <!--  标题  -->
                <TextBlock
                    Margin="0,0,0,4"
                    FontSize="28"
                    FontWeight="Bold"
                    Text="🖼️ 控件画廊" />
                <TextBlock
                    Margin="0,0,0,16"
                    FontSize="14"
                    Text="WPF 基本控件 · 滚动测试" />

                <!--  文本输入组  -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="📝 文本输入" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource LabelStyle}" Text="文本框" />
                        <TextBox Margin="0,0,0,8" Text="普通文本框" />
                        <TextBlock Style="{StaticResource LabelStyle}" Text="密码框" />
                        <PasswordBox Margin="0,0,0,8" Password="password" />
                        <TextBlock Style="{StaticResource LabelStyle}" Text="多行文本框" />
                        <TextBox
                            Height="60"
                            Margin="0,0,0,0"
                            AcceptsReturn="True"
                            Text="这是多行文本框的内容。可以输入多行文本用于测试滚动。第二行内容。第三行内容。"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!--  按钮组  -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="🔘 按钮" />
                <Border Style="{StaticResource Card}">
                    <WrapPanel>
                        <Button
                            Width="70"
                            Margin="0,0,8,8"
                            Content="普通" />
                        <ToggleButton
                            Width="70"
                            Margin="0,0,8,8"
                            Content="开关" />
                        <RepeatButton
                            Width="70"
                            Margin="0,0,8,8"
                            Content="重复" />
                        <Button Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontSize="16" Text="⭐" />
                                <TextBlock Margin="3,0,0,0" Text=" 图标" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </Border>

                <!--  选择控件组  -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="☑️ 选择控件" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <CheckBox Margin="0,2" Content="复选框 1" />
                        <CheckBox
                            Margin="0,2"
                            Content="复选框 2（已选）"
                            IsChecked="True" />
                        <CheckBox
                            Margin="0,2"
                            Content="复选框 3（禁用）"
                            IsEnabled="False" />
                        <RadioButton
                            Margin="0,2"
                            Content="单选 A"
                            GroupName="Group1"
                            IsChecked="True" />
                        <RadioButton
                            Margin="0,2"
                            Content="单选 B"
                            GroupName="Group1" />
                        <RadioButton
                            Margin="0,2"
                            Content="单选 C（禁用）"
                            GroupName="Group1"
                            IsEnabled="False" />
                    </StackPanel>
                </Border>

                <!--  日期控件组  -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="📅 日期与时间" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource LabelStyle}" Text="日期选择器" />
                        <DatePicker Margin="0,0,0,8" SelectedDate="2024-01-15" />
                        <TextBlock Style="{StaticResource LabelStyle}" Text="日期选择器（含时间）" />
                        <DatePicker Margin="0,0,0,0" SelectedDate="2024-01-15" />
                    </StackPanel>
                </Border>

            </StackPanel>

            <!--  ============ 右列 ============  -->
            <StackPanel Grid.Column="2">

                <!--  下拉选择组  -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="📋 下拉选择" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource LabelStyle}" Text="下拉框" />
                        <ComboBox Margin="0,0,0,8" SelectedIndex="0">
                            <ComboBoxItem Content="选项一" />
                            <ComboBoxItem Content="选项二" />
                            <ComboBoxItem Content="选项三" />
                            <ComboBoxItem Content="选项四" />
                            <ComboBoxItem Content="选项五" />
                            <ComboBoxItem Content="选项六" />
                            <ComboBoxItem Content="选项七" />
                            <ComboBoxItem Content="选项八" />
                            <ComboBoxItem Content="选项九" />
                            <ComboBoxItem Content="选项十" />
                        </ComboBox>
                        <TextBlock Style="{StaticResource LabelStyle}" Text="下拉框（可编辑）" />
                        <ComboBox
                            Margin="0,0,0,0"
                            IsEditable="True"
                            SelectedIndex="0">
                            <ComboBoxItem Content="可编辑选项 1" />
                            <ComboBoxItem Content="可编辑选项 2" />
                            <ComboBoxItem Content="可编辑选项 3" />
                        </ComboBox>
                    </StackPanel>
                </Border>

                <!--  滑块与进度组  -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="📊 滑块与进度" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource LabelStyle}" Text="滑块" />
                        <Slider
                            Margin="0,0,0,8"
                            Maximum="100"
                            Minimum="0"
                            Value="65" />
                        <TextBlock Style="{StaticResource LabelStyle}" Text="滑块（带刻度）" />
                        <Slider
                            Margin="0,0,0,8"
                            Maximum="100"
                            Minimum="0"
                            TickFrequency="10"
                            TickPlacement="BottomRight"
                            Value="30" />
                        <TextBlock Style="{StaticResource LabelStyle}" Text="进度条" />
                        <ProgressBar
                            Height="20"
                            Margin="0,0,0,0"
                            Maximum="100"
                            Minimum="0"
                            Value="75" />
                    </StackPanel>
                </Border>

                <!--  选项卡组  -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="📑 选项卡" />
                <Border Style="{StaticResource Card}">
                    <TabControl>
                        <TabItem Header="选项卡 1">
                            <TextBlock Margin="10" Text="这是选项卡 1 的内容。" />
                        </TabItem>
                        <TabItem Header="选项卡 2">
                            <StackPanel Margin="10">
                                <TextBlock Text="选项卡 2 包含更多控件：" />
                                <CheckBox Margin="0,5" Content="选项 A" />
                                <CheckBox Margin="0,5" Content="选项 B" />
                            </StackPanel>
                        </TabItem>
                        <TabItem Header="选项卡 3">
                            <TextBlock Margin="10" Text="选项卡 3 的内容。" />
                        </TabItem>
                    </TabControl>
                </Border>

                <!--  分组框与边框组  -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="📦 分组容器" />
                <Border Style="{StaticResource Card}">
                    <GroupBox Margin="0" Header="分组框示例">
                        <StackPanel>
                            <TextBlock Margin="0,2" Text="分组框内部的内容" />
                            <RadioButton Margin="0,2" Content="内部单选 A" />
                            <RadioButton Margin="0,2" Content="内部单选 B" />
                        </StackPanel>
                    </GroupBox>
                </Border>

                <!--  富文本组  -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="📄 富文本" />
                <Border Style="{StaticResource Card}">
                    <RichTextBox Height="100">
                        <FlowDocument>
                            <Paragraph FontWeight="Bold">富文本框</Paragraph>
                            <Paragraph>
                                支持<Run FontWeight="Bold">加粗</Run>
                                、<Run FontStyle="Italic">斜体</Run>
                                和<Run TextDecorations="Underline">下划线</Run>
                                。</Paragraph>
                            <Paragraph>第二段内容，用于测试滚动。</Paragraph>
                        </FlowDocument>
                    </RichTextBox>
                </Border>

                <!--  底部占位  -->
                <TextBlock
                    Margin="0,20,0,10"
                    HorizontalAlignment="Center"
                    FontWeight="SemiBold"
                    Text="—— 页面底部 ——" />

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>